# Login password for the PulseLog UI (minimum 12 chars in production)
APP_PASSWORD=replace-with-a-strong-login-password
# 32-byte key as 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional. When omitted, the single ES_* environment is used read-only.
DATABASE_URL=mysql://pulselog:password@mysql:3306/pulselog

# Bootstrap/read-only environment (also works without MySQL)
ES_NAME=Production
ES_URL=https://elasticsearch.example.com:9200
ES_INDEX_PATTERN=logs-*
ES_TIMESTAMP_FIELD=@timestamp
ES_MESSAGE_FIELD=message
ES_USERNAME=logs_reader
ES_PASSWORD=replace-me
# Alternative to username/password:
# ES_API_KEY=base64-api-key
ES_TLS_VERIFY=true
# Optional PEM string, supports literal \n escapes
# ES_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Docker Compose only
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
